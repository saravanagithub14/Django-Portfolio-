{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "Portfolio",
      "image": "./Dockerfile",
      // 1 GiB, 1/4 vCPU: the chatbot's models need about 425MB
      "instance_type": "basic",
      // One instance: it's the only writer of the SQLite file
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "Portfolio", "name": "PORTFOLIO" }]
  },
  "exports": {
    "Portfolio": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "BEHIND_CLOUDFLARE": "True",
    "EDGE_CACHE_SECONDS": "300",
    "CHATBOT_PROVIDER": "openai"
    // Add these once you have them (cloudflare.md):
    // "SITE_URL": "https://your-domain.com",
    // "R2_BUCKET": "portfolio-db",
    // "R2_ENDPOINT": "https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
  }
  // Custom domain (needed for page caching):
  // "routes": [{ "pattern": "your-domain.com", "custom_domain": true }]
}
